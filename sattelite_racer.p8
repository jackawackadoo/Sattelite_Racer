pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- sattelite racer

radius = 30
originx = 64
originy = 64
angle = 0


function _init()
	cls()
end

function _update()
	angle += 3
	if (angle > 360) angle = 0
	cls()
	x = originx + radius * cos(angle/360)
	y = originy + radius * sin(angle/360)
	spr(1, x, y)
end

function _draw()

end
